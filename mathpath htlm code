<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>MathPath</title>
<style>
:root{--bg:#f3f6f8;--c:#fff;--t:#14213d;--m:#667085;--p:#0f8f7e;--pl:#dff5f1;--w:#f59e0b;--r:#d92d20;--b:#e3e8ee}
body.d{--bg:#0e1522;--c:#172033;--t:#eaf0fa;--m:#98a4b8;--pl:#12372f;--b:#26324a}
*{box-sizing:border-box}body{margin:0;font:16px/1.5 "Avenir Next","Segoe UI",system-ui,sans-serif;background:var(--bg);color:var(--t)}
header{display:flex;align-items:center;gap:14px;padding:12px 20px;background:var(--c);border-bottom:1px solid var(--b);flex-wrap:wrap}
.logo{font-weight:800;font-size:22px;letter-spacing:-.5px;color:var(--p)}.sp{flex:1}
.pill{background:var(--pl);color:var(--p);border-radius:99px;padding:3px 12px;font-weight:600;font-size:14px}
nav{display:flex;gap:4px;padding:8px 20px;overflow-x:auto}
nav button,.btn{font:inherit;border:0;border-radius:10px;padding:8px 16px;cursor:pointer;background:none;color:var(--m);font-weight:600}
nav button.on{background:var(--c);color:var(--t);box-shadow:0 0 0 1px var(--b)}
.btn{background:var(--p);color:#fff}.btn.s{background:var(--c);color:var(--t);box-shadow:0 0 0 1px var(--b)}.btn:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--w);outline-offset:2px}
main{max-width:980px;margin:0 auto;padding:12px 20px 60px}
.card{background:var(--c);border:1px solid var(--b);border-radius:14px;padding:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px}
.t{cursor:pointer;text-align:left;font:inherit;color:var(--t)}.t:hover{border-color:var(--p)}
.bar{height:8px;background:var(--b);border-radius:9px;overflow:hidden}.bar i{display:block;height:100%;background:var(--p)}
h2{margin:22px 0 8px;font-size:20px}h3{margin:18px 0 6px;font-size:17px}small,.m{color:var(--m)}
.q{font-size:30px;font-weight:700;margin:18px 0;word-break:break-word}
input[type=text],input[type=number]{font:inherit;font-size:22px;padding:10px 14px;border:2px solid var(--b);border-radius:10px;background:var(--bg);color:var(--t);width:180px}
.av{font-size:34px;border:2px solid var(--b);border-radius:14px;background:var(--c);padding:6px;cursor:pointer;text-align:center}.av.on{border-color:var(--p)}.av.lk{opacity:.4;cursor:not-allowed}
.av small{display:block;font-size:11px;line-height:1.2}
.col{display:flex;gap:6px;align-items:flex-end;height:90px}.col div{flex:1;background:var(--p);border-radius:6px 6px 0 0;min-height:3px}
.ok{color:var(--p);font-weight:700}.no{color:var(--r);font-weight:700}
ol li{margin:6px 0}@media(prefers-reduced-motion:no-preference){.card{transition:border-color .15s}}
body.big{font-size:20px}.fade{animation:fi .45s}@keyframes fi{from{opacity:0;transform:translateY(6px)}}
@media(prefers-reduced-motion:reduce){.fade{animation:none}}
textarea{width:100%;height:70px;font:12px monospace;background:var(--bg);color:var(--t);border:1px solid var(--b);border-radius:8px}
input[type=range]{vertical-align:middle}
@media print{header,nav,button{display:none!important}}
header{position:sticky;top:0;z-index:5;box-shadow:0 1px 0 var(--b)}
.logo{display:flex;align-items:center}.mk{display:inline-grid;place-items:center;width:30px;height:30px;border-radius:8px;background:var(--p);color:#fff;font-weight:800;margin-right:8px}
.card{box-shadow:0 1px 2px rgba(16,24,40,.05)}.btn{border-radius:8px;padding:9px 18px;box-shadow:0 1px 2px rgba(16,24,40,.12)}.btn:hover{filter:brightness(1.07)}.btn.s{box-shadow:0 0 0 1px var(--b)}
h2{letter-spacing:-.3px}.sel{border-color:var(--p);box-shadow:0 0 0 2px var(--p)}
nav button b{font-weight:400;margin-right:8px}
body.pc nav{position:fixed;left:0;top:58px;bottom:0;width:200px;flex-direction:column;padding:16px 12px;background:var(--c);border-right:1px solid var(--b);overflow-y:auto;z-index:4}
body.pc nav button{text-align:left;width:100%}body.pc main{margin:0 0 0 200px;max-width:1100px;padding:20px 32px 60px}
body.ph #app{max-width:520px;margin:0 auto;min-height:100vh;background:var(--bg);box-shadow:0 0 0 1px var(--b)}
body.ph nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:min(520px,100%);background:var(--c);border-top:1px solid var(--b);padding:6px;justify-content:space-around;z-index:6}
body.ph nav button{flex:1;display:flex;flex-direction:column;align-items:center;font-size:11px;padding:6px 4px;min-width:0}body.ph nav button b{font-size:20px;margin:0}
body.ph main{padding:12px 14px 96px}body.ph .btn{min-height:44px}body.ph .grid{grid-template-columns:1fr 1fr}body.ph .q{font-size:26px}
body.ph input[type=number],body.ph input[type=text]{width:100%;margin-bottom:8px}body.ph header{padding:10px 14px}
.calc{max-width:300px;margin:10px 0}.cd{background:var(--bg);border:1px solid var(--b);border-radius:8px;padding:8px 10px;font:600 20px monospace;text-align:right;min-height:42px;overflow-x:auto}
.ck{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:8px}.ck button{font-size:18px;font-weight:600;padding:10px 0;border:1px solid var(--b);border-radius:8px;background:var(--c);color:var(--t);cursor:pointer}.ck .w{grid-column:span 2;font-size:14px}.ck .e{background:var(--p);color:#fff;border-color:var(--p)}
.toast{position:fixed;top:70px;left:50%;transform:translateX(-50%);background:var(--p);color:#fff;padding:10px 18px;border-radius:10px;font-weight:700;z-index:20;animation:fi .4s}
body.hc{--t:#000;--m:#222;--b:#555;--p:#066;--bg:#fff;--c:#fff}body.hc.d{--t:#fff;--m:#ddd;--b:#aaa;--p:#4de1cf;--bg:#000;--c:#000}
body.dy{font-family:"Trebuchet MS","Comic Sans MS",Verdana,sans-serif;letter-spacing:.03em;line-height:1.7}.pad{border:1px solid var(--b);border-radius:8px;background:#fff;touch-action:none;max-width:100%;margin-top:10px}
</style></head><body>
<div id="app"></div>
<script>
const R=(a,b)=>a+Math.floor(Math.random()*(b-a+1)),P=n=>n<0?`(${n})`:n,F=n=>+n.toFixed(2);
// [grade, name, concept, generator -> [question, answer, hint]]
const T=[
[1,'Add within 20','Adding means putting groups together. Count up from the bigger number.',()=>{let a=R(1,10),b=R(1,10);return[`${a} + ${b}`,a+b,'Start at the bigger number and count up.']}],
[1,'Subtract within 20','Subtracting means taking away. Count back, or think: what plus the small number makes the big one?',()=>{let a=R(8,20),b=R(1,8);return[`${a} − ${b}`,a-b,'Count back from the first number.']}],
[2,'Add 2-digit numbers','Add the ones, then the tens. Carry 1 ten if the ones make 10 or more.',()=>{let a=R(11,89),b=R(11,89);return[`${a} + ${b}`,a+b,'Add ones first, then tens.']}],
[2,'Subtract 2-digit numbers','Subtract ones, then tens. Borrow a ten when the top ones digit is smaller.',()=>{let a=R(40,99),b=R(11,39);return[`${a} − ${b}`,a-b,'Subtract the tens, then the ones.']}],
[2,'Place value','In a 2-digit number, the left digit counts tens and the right digit counts ones.',()=>{let n=R(11,99);return[`How many tens are in ${n}?`,Math.floor(n/10),'Look at the left digit.']}],
[3,'Multiplication facts','Multiplication is repeated addition: 4 × 3 means 4 groups of 3.',()=>{let a=R(2,10),b=R(2,10);return[`${a} × ${b}`,a*b,`Add ${a} together ${b} times.`]}],
[3,'Division facts','Division splits into equal groups. It is the opposite of multiplication.',()=>{let b=R(2,10),c=R(2,10);return[`${b*c} ÷ ${b}`,c,`What times ${b} makes ${b*c}?`]}],
[3,'Fractions of a number','To find 1/d of a number, divide it by d.',()=>{let d=R(2,5),n=d*R(2,8);return[`1/${d} of ${n}`,n/d,`Divide ${n} by ${d}.`]}],
[4,'Multi-digit multiplication','Multiply each place value separately, then add the partial products.',()=>{let a=R(12,99),b=R(3,9);return[`${a} × ${b}`,a*b,'Break it up: tens × ones, then ones × ones.']}],
[4,'Perimeter and area','Perimeter = 2 × (length + width). Area = length × width.',()=>{let l=R(3,15),w=R(2,10);return[`Area of a ${l} by ${w} rectangle`,l*w,'Multiply length by width.']}],
[4,'Remainders','When a division is not exact, the leftover is the remainder.',()=>{let a=R(20,99),b=R(3,9);return[`Remainder of ${a} ÷ ${b}`,a%b,`Find the biggest multiple of ${b} that fits.`]}],
[5,'Decimal addition','Line up the decimal points, then add as usual.',()=>{let a=R(11,99)/10,b=R(11,99)/10;return[`${a} + ${b}`,F(a+b),'Line up the decimal points.']}],
[5,'Order of operations','Do parentheses first, then multiplication and division, then addition and subtraction.',()=>{let a=R(2,9),b=R(2,9),c=R(2,9);return[`${a} + ${b} × ${c}`,a+b*c,'Multiply before you add.']}],
[5,'Volume of a box','Volume = length × width × height.',()=>{let l=R(2,9),w=R(2,9),h=R(2,9);return[`Volume of a ${l} × ${w} × ${h} box`,l*w*h,'Multiply all three sides.']}],
[6,'Percent of a number','Percent means "per 100". 25% of n = n × 25 ÷ 100.',()=>{let p=[10,20,25,50][R(0,3)],n=R(1,10)*20;return[`${p}% of ${n}`,p*n/100,'Multiply, then divide by 100.']}],
[6,'Unit rates','A unit rate compares a quantity to exactly 1 unit. Divide the total by the count.',()=>{let k=R(2,9),p=R(2,9);return[`${k} pens cost $k*p.Costof1pen()?`,p,'Divide cost by number of pens.']}],
[6,'Mean (average)','Mean = sum of values ÷ number of values.',()=>{let m=R(15,30),x=[1,2,3,4].map(()=>R(m-4,m+4)),l=5*m-x.reduce((a,b)=>a+b);x.push(l);return[`Mean of ${x.join(', ')}`,m,'Add them all, divide by 5.']}],
[7,'Integer operations','Adding a negative is like subtracting. Negative × negative = positive.',()=>{let a=R(-12,12),b=R(-12,12);return[`${a} + ${P(b)}`,a+b,'Think of a number line.']}],
[7,'Two-step equations','Undo addition/subtraction first, then undo multiplication/division.',()=>{let x=R(-9,9),a=R(2,9),b=R(1,15);return[`${a}x + ${b} = ${a*x+b}. x = ?`,x,'Subtract b from both sides, then divide.']}],
[7,'Proportions','In a proportion, cross-multiply to solve for the unknown.',()=>{let a=R(2,6),b=R(2,6),k=R(2,5);return[`x / ${b*k} = ${a} / ${b}. x = ?`,a*k,`Multiply ${a} by ${k}.`]}],
[8,'Slope','Slope = rise ÷ run = (y₂ − y₁) ÷ (x₂ − x₁).',()=>{let m=R(-5,5)||2,x=R(-3,3),y=R(-3,3),d=R(1,4);return[`Slope through (${x}, y)and({x+d}, ${y+m*d})`,m,'Rise over run.']}],
[8,'Pythagorean theorem','In a right triangle, a² + b² = c², where c is the hypotenuse.',()=>{let t=[[3,4,5],[5,12,13],[8,15,17],[6,8,10],[7,24,25]][R(0,4)];return[`Legs ${t[0]} and ${t[1]}. Hypotenuse?`,t[2],'Add the squares, then take the root.']}],
[8,'Square roots','√n is the number that multiplies by itself to give n.',()=>{let n=R(2,15);return[`√${n*n}`,n,`What times itself is ${n*n}?`]}],
[9,'Equations with variables on both sides','Collect x terms on one side and numbers on the other.',()=>{let x=R(-6,9),a=R(3,9),c=R(1,a-1),b=R(1,9),d=(a-c)*x+b;return[`${a}x + ${b} = ${c}x + ${d<0?'('+d+')':d}. x = ?`,x,`Subtract ${c}x from both sides.`]}],
[9,'Systems of equations','Add the equations to cancel y, then solve for x.',()=>{let x=R(1,8),y=R(1,8);return[`x + y = ${x+y} and x − y = ${x-y}. x = ?`,x,'Add the two equations.']}],
[9,'Factoring quadratics','x² − (p+q)x + pq = (x−p)(x−q). Roots are p and q.',()=>{let p=R(1,9),q=R(1,9);return[`Larger root of x² − ${p+q}x + ${p*q} = 0`,Math.max(p,q),'Find two numbers: product '+p*q+', sum '+(p+q)+'.']}],
[10,'Triangle angles','Angles in a triangle add up to 180°.',()=>{let a=R(30,80),b=R(30,80);return[`Angles ${a}° and ${b}°. Third angle?`,180-a-b,'Subtract from 180.']}],
[10,'Circle area','Area = πr². Here, give the coefficient of π.',()=>{let r=R(2,12);return[`Area of circle, radius ${r}, in multiples of π`,r*r,'Square the radius.']}],
[10,'Distance formula','Distance = √((x₂−x₁)² + (y₂−y₁)²). It is the Pythagorean theorem on a grid.',()=>{let k=R(1,5),x=R(-4,4),y=R(-4,4);return[`Distance from (${x}, y)to({x+3*k}, ${y+4*k})`,5*k,'Use the 3-4-5 triangle.']}],
[11,'Logarithms','log_b(x) asks: what power of b gives x?',()=>{let b=R(2,5),n=R(1,4);return[`log base ${b} of b**n`,n,`{b}^? = ${b**n}`]}],
[11,'Arithmetic series','Sum = n/2 × (2a + (n−1)d).',()=>{let a=R(1,9),d=R(1,5),n=R(5,12);return[`Sum of first ${n} terms: ${a}, ${a+d}, ${a+2*d}, …`,n*(2*a+(n-1)*d)/2,'Use the sum formula.']}],
[11,'Geometric sequences','nth term = a × r^(n−1).',()=>{let a=R(1,5),r=R(2,3),n=R(3,6);return[`Term ${n} of ${a}, ${a*r}, ${a*r*r}, …`,a*r**(n-1),`Multiply by ${r} each time.`]}],
[12,'Derivatives','The power rule: d/dx (a·xⁿ) = a·n·xⁿ⁻¹.',()=>{let a=R(2,6),n=R(2,4),c=R(1,3);return[`f(x) = ${a}x^${n}. Find f′(${c})`,a*n*c**(n-1),'Bring the power down, reduce it by 1.']}],
[12,'Combinations','nCr = n! ÷ (r!(n−r)!). Order does not matter.',()=>{let n=R(5,10),k=R(2,4),f=x=>x<2?1:x*f(x-1);return[`${n} choose ${k}`,f(n)/(f(k)*f(n-k)),'Use the factorial formula.']}],
[12,'Definite integrals','∫ kx dx = kx²/2. Evaluate at the top and subtract the bottom.',()=>{let k=2*R(1,4),n=R(2,6);return[`∫ from 0 to ${n} of ${k}x dx`,k*n*n/2,'Antiderivative is kx²/2.']}],
[12,'Limits','If a limit gives 0/0, factor and cancel first.',()=>{let a=R(2,9);return[`lim x→${a} of (x² − ${a*a}) ÷ (x − ${a})`,2*a,'Factor the top as (x−a)(x+a).']}],
[6,'Median','The median is the middle value when numbers are in order.',()=>{let a=[R(1,9),R(10,20),R(21,30),R(31,40),R(41,50)];return[`Median of ${[...a].sort(()=>Math.random()-.5).join(', ')}`,a[2],'Put them in order, pick the middle.']}],
[7,'Probability','Probability = favorable outcomes ÷ total outcomes. Give the answer as a percent.',()=>{let t=[4,5,10][R(0,2)],f=R(1,t-1);return[`A bag has ${t} equal marbles and ${f} are red. Chance of red (%)?`,f*100/t,'Favorable ÷ total × 100.']}],
[7,'Simple interest','Interest = principal × rate × time.',()=>{let p=R(1,9)*100,r=R(2,9),y=R(2,5);return[`$${p} at ${r}% simple interest for yyears.Interest()?`,p*r*y/100,'Multiply, then divide by 100.']}],
[10,'Trig ratios','sin = opposite ÷ hypotenuse, cos = adjacent ÷ hypotenuse, tan = opposite ÷ adjacent.',()=>{let k=R(1,5),f=[['sin',3,5],['cos',4,5],['tan',3,4]][R(0,2)];return[`Right triangle with sides ${3*k}, ${4*k}, ${5*k}. ${f[0]} of the angle opposite the ${3*k} side?`,f[1]/f[2],'Pick the right two sides, then divide.']}]];
const CN=['Counting & Adding','Fluency & Place Value','Multiplication & Fractions','Multi-digit Math','Decimals & Volume','Ratios & Statistics','Pre-Algebra','Functions & Geometry','Algebra 1','Geometry','Algebra 2','Precalculus & Calculus'];
const D=()=>({u:'',av:'🦊',xp:0,st:0,last:'',done:{},ans:0,cor:0,ch:0,dark:0,days:{},big:0,ui:innerWidth<700?'ph':'pc',wp:0,pl:0,wk:{id:0,xp:0},ut:{},fz:1,goal:20,path:'g',bg:0,hc:0,dy:0});
let S;try{S={...D(),...JSON.parse(localStorage.getItem('mp')||'{}')}}catch(e){S=D()}
const save=()=>{try{localStorage.setItem('mp',JSON.stringify(S));if(S.u)localStorage.setItem('mp:'+S.u,JSON.stringify(S))}catch(e){}};
const M=()=>T.filter((_,i)=>(S.done[i]||{}).e>=8).length,lv=()=>Math.floor(Math.sqrt(S.xp/50))+1;
const AV=[['🦊','Free',()=>1],['🐼','Free',()=>1],['🐙','Reach 100 XP',s=>s.xp>=100],['🦁','50 correct answers',s=>s.cor>=50],['🚀','Master 1 topic',()=>M()>=1],['🦄','3-day streak',s=>s.st>=3],['🤖','Challenge score 8+',s=>s.ch>=8],['🐉','Reach 600 XP',s=>s.xp>=600],['🧙','Master 5 topics',()=>M()>=5],['👑','Master 12 topics',()=>M()>=12],['🌌','Challenge score 15+',s=>s.ch>=15],['🏆','Master every topic',()=>M()>=T.length]];
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let V='learn',Q=null,cur=0,ex=0,G={m:1,b:0,n:1,d:2},PL=[],C='',tmp='';const $=s=>document.querySelector(s),day=o=>new Date(Date.now()-o*864e5).toISOString().slice(0,10);
const wk=x=>{let id=Math.floor(Date.now()/6048e5);S.wk={id,xp:(S.wk.id==id?S.wk.xp:0)+x}};function bump(ok){let L0=lv();S.ans++;if(ok){S.cor++;S.xp+=xp();wk(xp())}let t=day(0),d=S.done[Q.ci]=S.done[Q.ci]||{p:0,e:0};d.a=(d.a||0)+1;if(ok)d.c=(d.c||0)+1;d.t=t;if(S.last!==t){S.st=S.last===day(1)?S.st+1:S.last===day(2)&&S.fz>0?(S.fz--,S.st+1):1;S.last=t}S.days[t]=(S.days[t]||0)+1;save();if(lv()>L0)toast('🎉 Level '+lv()+': '+ttl())}
function nextQ(){let p=Q.m=='x'?[Q.seq[Q.k]]:Q.pool;Q.ci=p[R(0,p.length-1)];Q.c=T[Q.ci][3]();if(S.wp&&Q.m!='x')Q.c[0]=['A baker is working out','A pilot is checking','A coach is calculating','A builder is figuring out'][R(0,3)]+': '+Q.c[0];if(Q.rt.length&&Q.k>=Q.n-Q.rt.length)Q.c=Q.rt.shift();Q.hint=0;Q.fb='';Q.ans=0;Q.val=''}
function start(i,m,pool){Q={i,m,k:0,n:m=='e'||m=='u'?10:m=='x'?12:5,sc:0,t:m=='f'?30:60,pool:pool||[i],rt:[],g:pool?T[pool[0]][0]:0};if(m=='x')Q.seq=[...Array(12)].map((_,g)=>T.findIndex(t=>t[0]==g+1));nextQ();V='quiz';if(m=='c'||m=='f')Q.iv=setInterval(()=>{if(--Q.t<=0)finish();else if(('#tm'))('#tm').textContent=Q.t},1000);draw()}
function sub(){if(Q.ans)return nx();let v=parseFloat(('#a').value);if(isNaN(v))return;Q.val=('#a').value;let ok=Math.abs(v-Q.c[1])<.001;bump(ok);if(ok)Q.sc++;if(!ok&&Q.m=='x'&&!Q.fg)Q.fg=T[Q.ci][0];if(!ok&&Q.m=='p'&&Q.rt.length<3){Q.rt.push([...Q.c]);Q.n++}Q.ans=1;if(Q.m=='c'||Q.m=='f'){Q.k++;nextQ()}else Q.fb=(ok?`<span class=ok>Correct! +${xp()} XP</span>`:`<span class=no>Not quite.</span> Answer: ${Q.c[1]}.`)+`<br><small>Solution: ${esc(Q.c[0])} = ${Q.c[1]}. ${Q.c[2]}</small>`;draw()}
function nx(){Q.k++;if(Q.k>=Q.n)finish();else{nextQ();draw()}}
function finish(){clearInterval(Q.iv);if('crfu'.includes(Q.m)){if(Q.m=='c')S.ch=Math.max(S.ch,Q.sc);S.xp+=Q.sc*5;if(Q.m=='u'&&Q.sc>=8&&!S.ut[Q.g]){S.ut[Q.g]=1;S.xp+=50;toast('🏅 Unit test passed: +50 XP')}}else if(Q.m=='x')S.pl=Q.fg||12;else{let d=S.done[Q.i]=S.done[Q.i]||{p:0,e:0};if(Q.m=='p')d.p++;else{if(Q.sc>=8&&d.e<8)S.xp+=100;d.e=Math.max(d.e,Q.sc)}}save();V='res';draw()}
function draw(){let h=`<header><span class=logo><span class=mk>∑</span>MathPath</span><span class=sp></span>`;
if(S.u)h+=`<span class=pill>Level lv()</span><spanclass=pill>{S.xp} XP</span><span class=pill>🔥 S.st</span><spanstyle="font-size:24px;background:{BG[S.bg]};border-radius:50%;padding:2px 5px">S.av</span><b>{esc(S.u)}</b><small class=m>${ttl()}</small>`;
